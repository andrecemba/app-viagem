# ─────────────────────────────────────────────────────────────
# Copie para .env.local e preencha. Nunca faça commit deste arquivo com valores.
# Todas as variáveis ficam só no servidor (nenhuma começa com NEXT_PUBLIC_, exceto nome e URL do site).
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_NAME="Ração Certa"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Banco SQLite. Sem esta linha usa .data/racao.db (recomendado). Precisa de disco persistente.
# DATABASE_PATH=/caminho/racao.db
# 0 = não criar produtos e ofertas de exemplo na primeira abertura
SEED_DEMO=0

# Painel /admin — sem as três variáveis o painel fica fechado
ADMIN_EMAIL=
# Gere com: npm run admin:hash-senha -- "sua senha"
ADMIN_PASSWORD_HASH=
# Mínimo 32 caracteres aleatórios. Ex.: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Atualização programada de preços (POST /api/cron/precos com Authorization: Bearer ...). Mínimo 32 caracteres.
CRON_SECRET=

# Mercado Livre — API oficial com aplicativo registrado (developers.mercadolivre.com.br). Mais fácil: npm run ml:conectar
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REFRESH_TOKEN=
# Preenchidas por: npm run ml:conectar
MERCADOLIVRE_REDIRECT_URI=
# Alternativa para testes: token de acesso direto (expira em poucas horas)
MERCADOLIVRE_ACCESS_TOKEN=

# Shopee — Affiliate Open API. Só ligue (=1) depois de confirmar o acesso e os campos na documentação da sua conta.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_AFFILIATE_ENABLED=

# Amazon Associados — API oficial (Creators API). Integração pendente até haver acesso aprovado.
AMAZON_CREATORS_API_CLIENT_ID=
AMAZON_CREATORS_API_CLIENT_SECRET=
AMAZON_ASSOCIATE_TAG=

# Envio dos e-mails de "Avisar oferta" (serviço ainda não conectado)
EMAIL_API_KEY=
EMAIL_FROM=
