# ─────────────────────────────────────────────────────────────
# Copie para .env.local e preencha. Nunca faça commit de chaves.
# Na Fase 0 (dados de exemplo) nada aqui é obrigatório.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_NAME="Ração Certa"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Amazon Associados — uma tag por categoria para medir desempenho.
# Links são normalizados para https://www.amazon.com.br/dp/{ASIN}?tag={TAG}
AMAZON_TAG_RACAO=
AMAZON_TAG_PETISCO=
AMAZON_TAG_COMPLEMENTAR=
AMAZON_TAG_DEFAULT=
# Fase 2 — Creators API (a PA-API 5.0 foi descontinuada em 2026; exige vendas qualificadas).
# TODO(você): confirmar nomes das credenciais no painel de Associados.
AMAZON_CREATORS_API_CLIENT_ID=
AMAZON_CREATORS_API_CLIENT_SECRET=

# Awin (Cobasi) — deeplink: https://www.awin1.com/cread.php?awinmid={MID}&awinaffid={ID}&ued={URL}
AWIN_AFFILIATE_ID=
AWIN_MID_COBASI=
AWIN_API_TOKEN=

# Shopee Afiliados — Affiliate Open API (GraphQL): productOfferV2, generateShortLink
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# Mercado Livre — API de itens (OAuth). Links de afiliado são gerados no painel e cadastrados pelo admin.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REFRESH_TOKEN=

# Fase 1 — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Área administrativa (/admin) — ver docs/ADMIN.md
# Sem as três primeiras variáveis o painel fica fechado.
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=
# Gere com: npm run admin:hash-senha -- "sua senha"
ADMIN_PASSWORD_HASH=
# Mínimo 32 caracteres aleatórios. Ex.: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Pasta do arquivo de dados local (padrão: .data/ na raiz do projeto)
ADMIN_DATA_DIR=
# Segredo da rota POST /api/admin/cron (mínimo 32 caracteres). Vazio = agendamento desligado.
CRON_SECRET=
